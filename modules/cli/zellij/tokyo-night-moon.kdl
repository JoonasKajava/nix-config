// Tokyo Night Moon - Zellij component theme
themes {
    tokyonight-moon {
        text_unselected {
            base 200 211 245       // #c8d3f5 fg
            background 34 36 54    // #222436 terminal bg
            emphasis_0 255 150 108 // #ff966c orange
            emphasis_1 134 225 252 // #86e1fc cyan
            emphasis_2 195 232 141 // #c3e88d green
            emphasis_3 192 153 255 // #c099ff magenta
        }

        text_selected {
            base 200 211 245
            background 47 51 77    // #2f334d
            emphasis_0 255 150 108
            emphasis_1 134 225 252
            emphasis_2 195 232 141
            emphasis_3 192 153 255
        }

        ribbon_unselected {
            base 130 139 184       // #828bb8 white
            background 34 36 54
            emphasis_0 255 117 127 // #ff757f red
            emphasis_1 200 211 245
            emphasis_2 130 170 255 // #82aaff blue
            emphasis_3 192 153 255
        }

        ribbon_selected {
            base 34 36 54
            background 130 170 255 // blue
            emphasis_0 255 117 127
            emphasis_1 255 150 108
            emphasis_2 192 153 255
            emphasis_3 134 225 252
        }

        table_title {
            base 130 170 255
            background 34 36 54
            emphasis_0 255 150 108
            emphasis_1 134 225 252
            emphasis_2 195 232 141
            emphasis_3 192 153 255
        }

        table_cell_unselected {
            base 200 211 245
            background 34 36 54
            emphasis_0 255 150 108
            emphasis_1 134 225 252
            emphasis_2 195 232 141
            emphasis_3 192 153 255
        }

        table_cell_selected {
            base 200 211 245
            background 47 51 77
            emphasis_0 255 150 108
            emphasis_1 134 225 252
            emphasis_2 195 232 141
            emphasis_3 192 153 255
        }

        list_unselected {
            base 200 211 245
            background 34 36 54
            emphasis_0 255 150 108
            emphasis_1 134 225 252
            emphasis_2 195 232 141
            emphasis_3 192 153 255
        }

        list_selected {
            base 200 211 245
            background 47 51 77
            emphasis_0 255 150 108
            emphasis_1 134 225 252
            emphasis_2 195 232 141
            emphasis_3 192 153 255
        }

        frame_unselected {
            base 130 139 184
            background 34 36 54
            emphasis_0 255 150 108
            emphasis_1 134 225 252
            emphasis_2 195 232 141
            emphasis_3 192 153 255
        }

        frame_selected {
            base 130 170 255       // blue
            background 34 36 54
            emphasis_0 255 117 127
            emphasis_1 134 225 252
            emphasis_2 195 232 141
            emphasis_3 192 153 255
        }

        frame_highlight {
            base 255 150 108       // orange
            background 34 36 54
            emphasis_0 255 117 127
            emphasis_1 130 170 255
            emphasis_2 195 232 141
            emphasis_3 192 153 255
        }

        exit_code_success {
            base 195 232 141       // green
            background 34 36 54
            emphasis_0 195 232 141
            emphasis_1 195 232 141
            emphasis_2 195 232 141
            emphasis_3 195 232 141
        }

        exit_code_error {
            base 255 117 127       // red
            background 34 36 54
            emphasis_0 255 117 127
            emphasis_1 255 117 127
            emphasis_2 255 117 127
            emphasis_3 255 117 127
        }

        multiplayer_user_colors {
            player_1 192 153 255   // magenta
            player_2 130 170 255   // blue
            player_3 134 225 252   // cyan
            player_4 255 199 119   // yellow
            player_5 195 232 141   // green
            player_6 255 150 108   // orange
            player_7 255 117 127   // red
            player_8 200 211 245   // fg
            player_9 130 139 184   // white
            player_10 47 51 77     // bg
        }
    }
}
