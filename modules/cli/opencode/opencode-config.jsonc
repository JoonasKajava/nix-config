      "pwsh *Out-String*": "allow",
      "powershell *Get-*": "allow",
      "powershell *Select-Object*": "allow",
      "powershell *Select-String*": "allow",
      "powershell *Test-Path*": "allow",
      "powershell *Resolve-Path*": "allow",
      "powershell *Measure-Object*": "allow",
      "powershell *Compare-Object*": "allow",
