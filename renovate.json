{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Helsinki",
  "schedule": ["before 6am on monday"],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images in Nix modules",
      "managerFilePatterns": ["/^modules/.+\\.nix$/"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\"@\\s]+?):(?<currentValue>[^\"@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "matchDepNames": ["nix-config-private", "system-age"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchDepNames": ["postgres", "docker.io/library/postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "container images"
    }
  ]
}
